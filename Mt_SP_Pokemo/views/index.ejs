<main class="page-home">
  <section class="home-intro">
    <p class="home-label">POKEMO</p>
    <h1 id="welcomeTitle">Willkommen bei Pokemo</h1>
    <p>Spiele deine Lieblingsminispiele und sammle Pokemo-Punkte.</p>
  </section>

  <section class="game-list" aria-label="Spiele">
    <a class="game-card" href="/pokecross">
      <h2>Pokecross</h2>
      <p>Springe über den Pfad und entscheide, wann du deinen Gewinn sicherst.</p>
      <span>Pokecross spielen &rarr;</span>
    </a>

    <a class="game-card" href="/glutox">
      <h2>Glutox</h2>
      <p>Spiele eine Runde Glutox und sammle Pokemo-Punkte.</p>
      <span>Glutox spielen &rarr;</span>
    </a>
  </section>

  <section class="statistics-section" aria-labelledby="statisticsTitle">
    <header class="statistics-heading">
      <div>
        <h2 id="statisticsTitle">Deine Statistiken</h2>
        <p>Dein bisheriger Fortschritt bei Pokemo</p>
      </div>
      <span class="statistics-badge">Übersicht</span>
    </header>

    <div class="statistics-grid">
      <article class="statistics-card">
        <div class="statistics-card-heading">
          <h3>Gespielte Runden</h3>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 7h12a3 3 0 0 1 2.9 2.3l1 4A2.2 2.2 0 0 1 19.8 16l-2.5-2H6.7l-2.5 2A2.2 2.2 0 0 1 1.1 13.3l1-4A3 3 0 0 1 5 7Z"/><path d="M7 9v4m-2-2h4m7-1h.01M18 12h.01"/></svg>
        </div>
        <p class="statistics-value" id="statisticsPlayed">0</p>
        <p class="statistics-caption">In allen Minispielen</p>
      </article>

      <article class="statistics-card">
        <div class="statistics-card-heading">
          <h3>Gewonnene Runden</h3>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M8 21h8m-4-4v4M7 4h10v5a5 5 0 0 1-10 0V4Zm0 2H4v2a4 4 0 0 0 4 4m9-6h3v2a4 4 0 0 1-4 4"/></svg>
        </div>
        <p class="statistics-value" id="statisticsWon">0</p>
        <p class="statistics-caption">Deine bisherigen Siege</p>
      </article>

      <article class="statistics-card">
        <div class="statistics-card-heading">
          <h3>Siegquote</h3>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></svg>
        </div>
        <p class="statistics-value" id="statisticsWinRate">0,0 %</p>
        <p class="statistics-caption" id="statisticsWinRateCaption">0 von 0 Runden</p>
      </article>

      <article class="statistics-card">
        <div class="statistics-card-heading">
          <h3>Verdiente Punkte</h3>
          <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="8" cy="8" r="5"/><path d="m8 6 1.5 2L8 10m8-3a5 5 0 1 1-3.5 8.6M16 11l1.5 2L16 15m-4-1a5 5 0 0 1 7 7"/></svg>
        </div>
        <p class="statistics-value" id="statisticsPoints">0</p>
        <p class="statistics-caption">Insgesamt gesammelt</p>
      </article>
    </div>
  </section>

  <section class="achievements-section" aria-labelledby="achievementsTitle">
    <header class="achievements-heading">
      <div>
        <h2 id="achievementsTitle">Deine Abzeichen</h2>
        <p>Sammele Auszeichnungen für deine Erfolge.</p>
      </div>
      <span class="achievements-count" id="achievementsCount">0 von 6 freigeschaltet</span>
    </header>
    <div class="achievement-grid" id="achievementGrid" aria-label="Verfügbare Abzeichen"></div>
  </section>

  <dialog class="achievement-dialog" id="achievementDialog" aria-labelledby="achievementDetailsTitle">
    <div class="achievement-dialog-header">
      <span class="achievement-dialog-icon" id="achievementDetailsIcon" aria-hidden="true"></span>
      <button class="achievement-dialog-close" id="achievementDetailsClose" type="button" aria-label="Schließen">&times;</button>
    </div>
    <h3 id="achievementDetailsTitle"></h3>
    <p id="achievementDetailsCondition"></p>
    <p class="achievement-details-date" id="achievementDetailsDate"></p>
  </dialog>
</main>
