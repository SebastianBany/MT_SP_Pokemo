<main class="page page-pokecross" data-page="pokecross">
    <section class="game-shell">
        <header class="game-heading">
            <div>
                <h1>Pokecross<span class="heading-accent">.</span></h1>
                <p class="game-subtitle">Springe mit deinem Pokemon über den Pfad.</p>
            </div>
        </header>

        <section class="game-panel" aria-label="Pokecross-Spiel">
            <header class="game-panel-header">
                <div>
                    <h2>Bereit für den nächsten Sprung?</h2>
                </div>
                <span class="state-chip" id="gameStateLabel" data-state="loading">POKEMON LÄDT</span>
            </header>

            <div class="canvas-container">
                <canvas id="canvasPokecross" width="1280" height="460" role="img" aria-label="Spielfeld mit 22 Sprüngen, fünf sichtbaren Feldern, sinkender Überlebenschance und deinem Pokemon">
                    Dein Browser unterstützt das Canvas-Element nicht.
                </canvas>
                <div class="payout-animation" id="payoutAnimation" aria-hidden="true" hidden>
                    <span class="payout-animation-label">GEWONNEN</span>
                    <strong id="payoutAmount">+0</strong>
                    <small>Pokemo-Punkte</small>
                </div>
                <div class="game-bet game-bet-overlay" id="gameBet" role="dialog" aria-modal="true" aria-labelledby="gameBetTitle">
                    <section class="game-bet-card">
                        <span class="game-bet-kicker">DEIN EINSATZ</span>
                        <h3 id="gameBetTitle">Wie viele Pokemo-Punkte setzt du?</h3>
                        <label for="stakeAmount">Einsatz</label>
                        <input id="stakeAmount" type="number" min="10" step="10" value="10" inputmode="numeric" autofocus>
                        <button class="pokecross-button pokecross-button-all-in game-all-in-button" id="allInButton" type="button">All-in</button>
                        <p class="game-bet-balance">Verfügbares Guthaben: <strong id="availablePoints">100</strong></p>
                        <button class="pokecross-button pokecross-button-start" id="startGame" type="button" disabled>Pokemon wird geladen ...</button>
                    </section>
                </div>
            </div>

            <div class="pokecross-controls">
                <button class="pokecross-button pokecross-button-cross" id="crossButton" type="button" hidden disabled>Cross springen</button>
                <button class="pokecross-button pokecross-button-exit" id="exitButton" type="button" hidden disabled>Aussteigen (x1.0)</button>
            </div>

            <div class="game-panel-footer">
                <p class="game-status" id="gameStatus" role="status" aria-live="polite">Dein Pokemon wird aus der PokeAPI geladen.</p>
            </div>
        </section>
    </section>
</main>
<div class="game-over-overlay" id="gameOverOverlay" role="alertdialog" aria-modal="true" aria-labelledby="gameOverTitle" hidden>
    <section class="game-over-card">
        <span class="game-over-kicker">DEIN GUTHABEN IST AUFGEBRAUCHT</span>
        <h2 id="gameOverTitle">GAME OVER</h2>
        <p>Dein Spielstand wurde zurückgesetzt. Starte mit deinem Starter-Pokemon und frischen Pokemo-Punkten neu.</p>
        <button class="pokecross-button pokecross-button-start game-over-restart-button" id="restartGame" type="button">Von vorne anfangen</button>
    </section>
</div>
