<nav class="navbar" aria-label="Hauptnavigation">
	<div class="container-fluid">
		<div class="brand-group">
			<a class="navbar-brand" href="/">Pokemo</a>
			<button class="navbar-toggler" type="button" onclick="toggleMenu()" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Menü öffnen">
				<img class="navbar-toggler-image" src="/images/pokeball.svg" alt="">
			</button>
		</div>

		<button class="egg-button" type="button" aria-label="Pokemo-Ei öffnen" onclick="openEggBox()">
			<img class="egg-icon" src="/images/pokemon-egg.png" alt="">
		</button>

		<div class="profile-card">
			<button class="profile-picture pokemon-profile-button" type="button" aria-label="Pokemo auswählen" aria-haspopup="dialog" onclick="openPokemonPicker()">
				<span class="profile-menu-dots" aria-hidden="true">&#8942;</span>
				<img class="profile-pokemon-image" src="" alt="" hidden>
			</button>
			<div class="profile-info">
				<input type="text" id="username" placeholder="Username" maxlength="20">
				<p>Pokemo-Punkte: <span id="pokemonPoints">0</span></p>
				<p>Level 1</p>
				<div class="xp-bar">
					<div class="xp-progress"></div>
				</div>
				<p class="xp-label">0 XP</p>
			</div>
		</div>

		<dialog class="pokemon-picker" id="pokemonPicker" aria-labelledby="pokemonPickerTitle">
			<div class="pokemon-picker-header">
				<h2 id="pokemonPickerTitle">Wähle ein Pokemo</h2>
				<button class="pokemon-picker-close" type="button" onclick="closePokemonPicker()" aria-label="Fenster schließen">&times;</button>
			</div>
			<div class="starter-pokemon-list" id="starterPokemonList" aria-label="Starter-Pokemos"></div>
			<p class="pokemon-count" id="pokemonCount">Pokemos werden geladen...</p>
		</dialog>

		<dialog class="egg-box" id="eggBox" aria-labelledby="eggBoxTitle">
			<div class="egg-box-header">
				<h2 id="eggBoxTitle">Pokemo-Ei</h2>
				<button class="egg-box-close" type="button" onclick="closeEggBox()" aria-label="Fenster schließen">&times;</button>
			</div>

			<details class="egg-odds">
				<summary>Varianten anzeigen</summary>
				<div class="egg-variants" aria-label="Varianten-Wahrscheinlichkeiten">
					<span><b>Normal:</b> 97 %</span>
					<span><b>Shiny:</b> 2 %</span>
					<span><b>Golden:</b> 0,8 %</span>
					<span><b>Diamond:</b> 0,15 %</span>
					<span><b>Rainbow:</b> 0,04 %</span>
					<span><b>Shadow:</b> 0,01 %</span>
				</div>
				<p class="egg-source">Datenquelle: PokéAPI. Shiny-/Shadow-Verfügbarkeit: PoGoAPI. Farbvarianten sind spielintern.</p>
			</details>

			<div class="egg-result-area">
				<div class="egg-animation" id="eggAnimation" aria-hidden="true">
					<img class="egg-icon large" src="/images/pokemon-egg.png" alt="">
				</div>
				<img class="egg-pokemon-image" id="eggPokemonImage" src="" alt="" hidden>
				<h3 class="egg-pokemon-name" id="eggPokemonName"></h3>
				<p class="egg-variant" id="eggVariant"></p>
				<p class="egg-message" id="eggMessage" role="status" aria-live="polite">Klicke auf das Ei, um ein Pokemo zu ziehen!</p>
			</div>

			<button class="egg-open-button" id="eggOpenButton" type="button" onclick="openEgg()">Ei öffnen</button>
		</dialog>
		
		<dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
			<div class="drawer-header">
				<h2 class="drawer-title" id="navbarNavAltMarkupLabel">Menü</h2>
				<button class="menu-close" type="button" onclick="closeMenu()" aria-label="Menü schließen">&times;</button>
			</div>
			<div class="drawer-body">
				<div class="nav nav-pills navbar-nav">
					<a class="nav-link<%= title === 'Pokemo' ? ' active' : '' %>" <%= title === 'Pokemo' ? 'aria-current="page"' : '' %> href="/">Home</a>
					<a class="nav-link<%= title === 'Glutox' ? ' active' : '' %>" <%= title === 'Glutox' ? 'aria-current="page"' : '' %> href="/glutox">Glutox</a>
					<a class="nav-link<%= title === 'Pokecross' ? ' active' : '' %>" <%= title === 'Pokecross' ? 'aria-current="page"' : '' %> href="/pokecross">Pokecross</a>
				</div>
			</div>
		</dialog>
	</div>
</nav>
<script>
	var usernameInput = document.getElementById('username');
	var menu = document.getElementById('navbarNavAltMarkup');
	var menuButton = document.querySelector('.navbar-toggler');

	usernameInput.value = localStorage.getItem('username') || '';

	function updateWelcomeTitle() {
		var welcomeTitle = document.getElementById('welcomeTitle');
		var username = usernameInput.value.trim();
		if (welcomeTitle) {
			welcomeTitle.textContent = username
				? username + ', willkommen bei Pokemo'
				: 'Willkommen bei Pokemo';
		}
	}

	usernameInput.addEventListener('input', function () {
		localStorage.setItem('username', usernameInput.value);
		updateWelcomeTitle();
	});

	document.addEventListener('DOMContentLoaded', updateWelcomeTitle);
	window.addEventListener('storage', function (event) {
		if (event.key === 'username') {
			usernameInput.value = event.newValue || '';
			updateWelcomeTitle();
		}
	});

	function toggleMenu() {
		if (menu.open) {
			closeMenu();
		} else {
			menu.show();
			menuButton.setAttribute('aria-expanded', 'true');
		}
	}

	function closeMenu() {
		menu.close();
		menuButton.setAttribute('aria-expanded', 'false');
	}

	document.addEventListener('click', function (event) {
		if (menu.open && !menu.contains(event.target) && !menuButton.contains(event.target)) {
			closeMenu();
		}
	});
</script>
