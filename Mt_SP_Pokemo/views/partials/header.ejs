<nav class="navbar sm:navbar-expand bg-1 fg-2" aria-label="Hauptnavigation">
	<div class="container-fluid">
		<div class="brand-group">
			<a class="navbar-brand" href="/">Pokemo</a>
			<button class="btn-icon navbar-toggler" type="button" onclick="openMenu()" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Menü öffnen">
				<img class="navbar-toggler-image" src="/images/pokeball.svg" alt="">
			</button>
		</div>
		
		<div class="profile-card">
			<button class="profile-picture" id="openPokemonPicker" type="button" aria-label="Pokémon auswählen" title="Pokémon auswählen">
				<img id="profilePokemon" src="/images/pokeball.svg" alt="">
			</button>
			<div class="profile-info">
				<input type="text" id="username" placeholder="Username" maxlength="20" oninput="saveUsername()">
				
				<p>Pokemo-Punkte: 0</p>
				<p>Level 1</p>
				<div class="xp-bar">
					<div class="xp-progress"></div>
				</div>
				<p>0 XP</p>
			</div>
		</div>

		<dialog class="pokemon-picker" id="pokemonPicker" aria-labelledby="pokemonPickerTitle">
			<div class="pokemon-picker-header">
				<h2 id="pokemonPickerTitle">Wähle ein Pokémon</h2>
				<button class="btn-close" id="closePokemonPicker" type="button" aria-label="Schließen">&times;</button>
			</div>
			<label for="pokemonSearch">Pokémon suchen</label>
			<input id="pokemonSearch" type="search" placeholder="Name eingeben" disabled>
			<div class="pokemon-picker-content">
				<select id="pokemonList" size="8" aria-label="Pokémon"></select>
				<div class="pokemon-picker-preview">
					<img id="pokemonPreview" src="/images/pokeball.svg" alt="">
					<p id="pokemonPreviewName">Wähle ein Pokémon</p>
				</div>
			</div>
			<p id="pokemonPickerStatus" role="status" aria-live="polite"></p>
			<button class="pokemon-select-button" id="selectPokemon" type="button" disabled>Auswählen</button>
		</dialog>
		
		<dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
			<div class="drawer-header">
				<h2 class="drawer-title" id="navbarNavAltMarkupLabel">Menü</h2>
				<button class="btn-close" type="button" onclick="closeMenu()" aria-label="Menü schließen">&times;</button>
			</div>
			<div class="drawer-body">
				<div class="nav nav-pills navbar-nav">
					<a class="nav-link<%= title === 'Pokemo' ? ' active' : '' %>"<% if (title === 'Pokemo') { %> aria-current="page"<% } %> href="/">Home</a>
					<a class="nav-link<%= title === 'Glutox' ? ' active' : '' %>"<% if (title === 'Glutox') { %> aria-current="page"<% } %> href="/glutox">Glutox</a>
					<a class="nav-link<%= title === 'Pokecross' ? ' active' : '' %>"<% if (title === 'Pokecross') { %> aria-current="page"<% } %> href="/pokecross">Pokecross</a>
				</div>
			</div>
		</dialog>
	</div>
</nav>
<script>
	
	function saveUsername() {
		var username = document.getElementById('username').value;
		localStorage.setItem('username', username);
	}

	var savedUsername = localStorage.getItem('username');
	if (savedUsername) {
		document.getElementById('username').value = savedUsername;
	}

	
	function openMenu() {
		var drawer = document.getElementById('navbarNavAltMarkup');
		var menuButton = document.querySelector('.navbar-toggler');

		drawer.show();
		menuButton.setAttribute('aria-expanded', 'true');
	}

	
	function closeMenu() {
		var drawer = document.getElementById('navbarNavAltMarkup');
		drawer.close();
	}

	
	document.getElementById('navbarNavAltMarkup').addEventListener('close', function () {
		var menuButton = document.querySelector('.navbar-toggler');
		menuButton.setAttribute('aria-expanded', 'false');
	});

	document.addEventListener('click', function (event) {
		var drawer = document.getElementById('navbarNavAltMarkup');
		var menuButton = document.querySelector('.navbar-toggler');

		if (drawer.open && !drawer.contains(event.target) && !menuButton.contains(event.target)) {
			closeMenu();
		}
	});
</script>
