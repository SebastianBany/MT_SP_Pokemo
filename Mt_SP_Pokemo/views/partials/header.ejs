<nav class="navbar sm:navbar-expand bg-1 fg-2" aria-label="Hauptnavigation">
	<div class="container-fluid">
		<a class="navbar-brand" href="/">Pokemo</a>
		<!-- Maxi: (Pokeball-Menueknopf) Ein Klick auf das Bild oeffnet das Menue. -->
		<button class="btn-icon navbar-toggler" type="button" onclick="openMenu()" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Menue oeffnen">
			<img class="navbar-toggler-image" src="/images/pokeball.svg" alt="">
		</button>
		<!-- Maxi: Profilkarte -->
		<div class="profile-card">
			<div class="profile-picture">...</div>
			<div class="profile-info">
				<input type="text" id="username" placeholder="Username" maxlength="20" oninput="saveUsername()">
				<!-- Maxi: Profilkarte -->
				<p>Pokemo-Punkte: 0</p>
				<p>Level 1</p>
				<div class="xp-bar">
					<div class="xp-progress"></div>
				</div>
				<p>0 XP</p>
			</div>
		</div>
		<!-- Maxi: (Menuefenster) Hier stehen die Links, die beim Klick auf den Pokeball erscheinen. -->
		<dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
			<div class="drawer-header">
				<h2 class="drawer-title" id="navbarNavAltMarkupLabel">Menue</h2>
				<button class="btn-close" type="button" onclick="closeMenu()" aria-label="Menue schliessen">&times;</button>
			</div>
			<div class="drawer-body">
				<div class="nav nav-pills navbar-nav">
					<a class="nav-link<%= title === 'Pokemo' ? ' active' : '' %>"<% if (title === 'Pokemo') { %> aria-current="page"<% } %> href="/">Home</a>
					<a class="nav-link<%= title === 'Glutox' ? ' active' : '' %>"<% if (title === 'Glutox') { %> aria-current="page"<% } %> href="/glutox">Glutox</a>
					<a class="nav-link<%= title === 'Pokecross' ? ' active' : '' %>"<% if (title === 'Pokecross') { %> aria-current="page"<% } %> href="/pokecross">Pokecross</a>
				</div>
			</div>
		</dialog>
	</div>
</nav>
<script>
	// Maxi: Username speichern
	function saveUsername() {
		var username = document.getElementById('username').value;
		localStorage.setItem('username', username);
	}

	var savedUsername = localStorage.getItem('username');
	if (savedUsername) {
		document.getElementById('username').value = savedUsername;
	}

	// Maxi: (Menue öffnen) Zeigt das Menuefenster und markiert den Knopf als geoeffnet.
	function openMenu() {
		var drawer = document.getElementById('navbarNavAltMarkup');
		var menuButton = document.querySelector('.navbar-toggler');

		drawer.showModal();
		menuButton.setAttribute('aria-expanded', 'true');
	}

	// Maxi: (Menue schliessen) Macht das Menuefenster wieder zu.
	function closeMenu() {
		var drawer = document.getElementById('navbarNavAltMarkup');
		drawer.close();
	}

	// Maxi: (Menue-Status) Setzt den Knopf auf geschlossen, wenn das Menue zugeht.
	document.getElementById('navbarNavAltMarkup').addEventListener('close', function () {
		var menuButton = document.querySelector('.navbar-toggler');
		menuButton.setAttribute('aria-expanded', 'false');
	});
</script>
