<nav class="navbar sm:navbar-expand bg-1 fg-2" aria-label="Hauptnavigation">
	<div class="container-fluid">
		<a class="navbar-brand" href="/">Pokemo</a>
		<button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Menue oeffnen">
			<span class="navbar-toggler-icon" aria-hidden="true"></span>
		</button>
		<dialog class="drawer drawer-end" tabindex="-1" id="navbarNavAltMarkup" aria-labelledby="navbarNavAltMarkupLabel">
			<div class="drawer-header">
				<h2 class="drawer-title" id="navbarNavAltMarkupLabel">Menue</h2>
				<button class="btn-close" type="button" data-bs-dismiss="drawer" aria-label="Menue schliessen">&times;</button>
			</div>
			<div class="drawer-body">
				<div class="nav nav-pills navbar-nav">
					<a class="nav-link<%= title === 'Pokemo' ? ' active' : '' %>"<% if (title === 'Pokemo') { %> aria-current="page"<% } %> href="/">Home</a>
					<a class="nav-link<%= title === 'Glutox' ? ' active' : '' %>"<% if (title === 'Glutox') { %> aria-current="page"<% } %> href="/glutox">Glutox</a>
					<a class="nav-link<%= title === 'Pokecross' ? ' active' : '' %>"<% if (title === 'Pokecross') { %> aria-current="page"<% } %> href="/pokecross">Pokecross</a>
				</div>
			</div>
		</dialog>
	</div>
</nav>
<script>
	document.addEventListener('click', function (event) {
		const toggle = event.target.closest('[data-bs-toggle="drawer"]');
		const close = event.target.closest('[data-bs-dismiss="drawer"]');
		const drawer = document.getElementById('navbarNavAltMarkup');

		if (toggle && drawer) {
			drawer.showModal();
			toggle.setAttribute('aria-expanded', 'true');
		} else if (close && drawer) {
			drawer.close();
			document.querySelector('[data-bs-toggle="drawer"]')?.setAttribute('aria-expanded', 'false');
		}
	});

	document.getElementById('navbarNavAltMarkup')?.addEventListener('close', function () {
		document.querySelector('[data-bs-toggle="drawer"]')?.setAttribute('aria-expanded', 'false');
	});

	document.getElementById('navbarNavAltMarkup')?.addEventListener('cancel', function () {
		document.querySelector('[data-bs-toggle="drawer"]')?.setAttribute('aria-expanded', 'false');
	});

	document.addEventListener('keydown', function (event) {
		const drawer = document.getElementById('navbarNavAltMarkup');
		if (event.key === 'Escape' && drawer?.open) {
			drawer.close();
			document.querySelector('[data-bs-toggle="drawer"]')?.setAttribute('aria-expanded', 'false');
		}
	});
</script>
