<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <% if (typeof pageCss !== 'undefined') { %>
    <link rel="stylesheet" href="<%= pageCss %>">
    <% } %>
    <script src="/javascripts/pokemo-points.js" defer></script>
    <script src="/javascripts/pokemo-stats.js" defer></script>
    <script src="/javascripts/pokemo-progression.js" defer></script>
    <script src="/javascripts/pokemo-achievements.js" defer></script>
    <script src="/javascripts/pokemo-profile.js" defer></script>
    <script src="/javascripts/pokeapi.js" defer></script>
    <% if (typeof pageJs !== 'undefined') { %>
    <link rel="stylesheet" href="/stylesheets/game-animations.css">
    <script src="/javascripts/game-animations.js" defer></script>
    <% } %>
</head>
<body>
    <%- include('../partials/header') %>
    <%- body %>
    <% if (typeof pageJs !== 'undefined') { %>
    <script src="<%= pageJs %>" defer></script>
    <% } %>
    <%- include('../partials/footer') %>
    <div class="achievement-toast" id="achievementToast" role="status" aria-live="polite" hidden>
        <span class="achievement-toast-icon" id="achievementToastIcon" aria-hidden="true"></span>
        <span class="achievement-toast-message">
            <strong>Abzeichen freigeschaltet</strong>
            <span id="achievementToastName"></span>
        </span>
    </div>
</body>
</html>